Grammar

    0 $accept: PROGRAM $end

    1 PROGRAM: STMT_LIST
    2        | PROGRAM END

    3 STMT_LIST: STMT
    4          | STMT_LIST STMT

    5 STMT: EXPR_STMT
    6     | VAR_DECL_STMT
    7     | FUNC_DECL_STMT
    8     | FOR_STMT
    9     | IF_STMT
   10     | CONTINUE_STMT
   11     | BREAK_STMT
   12     | WHILE_STMT
   13     | RETURN_STMT
   14     | BLOCK_STMT
   15     | SEMICOLON

   16 CONTINUE_STMT: CONTINUE SEMICOLON

   17 EXPR_STMT: EXPR SEMICOLON

   18 VAR_DECLARATION: TYPE VAR_DECLARATOR_LIST
   19                | CONST TYPE VAR_DECLARATOR_LIST

   20 VAR_DECL_STMT: VAR_DECLARATION SEMICOLON

   21 BLOCK_STMT: LBRACE RBRACE
   22           | LBRACE STMT_LIST RBRACE

   23 FUNC_BODY: LBRACE RBRACE
   24          | LBRACE STMT_LIST RBRACE

   25 FUNC_DECL_STMT: TYPE IDENT LPAREN PARAM_DECLARATOR_LIST RPAREN FUNC_BODY

   26 FOR_STMT: FOR LPAREN VAR_DECLARATION SEMICOLON EXPR SEMICOLON EXPR RPAREN STMT
   27         | FOR LPAREN EXPR SEMICOLON EXPR SEMICOLON EXPR RPAREN STMT

   28 IF_STMT: IF LPAREN EXPR RPAREN STMT
   29        | IF LPAREN EXPR RPAREN STMT ELSE STMT

   30 BREAK_STMT: BREAK SEMICOLON

   31 RETURN_STMT: RETURN SEMICOLON
   32            | RETURN EXPR SEMICOLON

   33 WHILE_STMT: WHILE LPAREN EXPR RPAREN STMT

   34 PARAM_DECLARATOR: TYPE IDENT
   35                 | TYPE IDENT LBRACKET RBRACKET
   36                 | TYPE IDENT ARRAY_DIMENSION_EXPR_LIST
   37                 | TYPE IDENT LBRACKET RBRACKET ARRAY_DIMENSION_EXPR_LIST

   38 PARAM_DECLARATOR_LIST: ε
   39                      | PARAM_DECLARATOR
   40                      | PARAM_DECLARATOR_LIST COMMA PARAM_DECLARATOR

   41 VAR_DECLARATOR: LEFT_VAL_EXPR
   42               | LEFT_VAL_EXPR ASSIGN INITIALIZER

   43 VAR_DECLARATOR_LIST: VAR_DECLARATOR
   44                    | VAR_DECLARATOR_LIST COMMA VAR_DECLARATOR

   45 INITIALIZER: NOCOMMA_EXPR
   46            | LBRACE RBRACE
   47            | LBRACE INITIALIZER_LIST RBRACE

   48 INITIALIZER_LIST: INITIALIZER
   49                 | INITIALIZER_LIST COMMA INITIALIZER

   50 ASSIGN_EXPR: CONDITIONAL_EXPR
   51            | LEFT_VAL_EXPR ASSIGN ASSIGN_EXPR
   52            | LEFT_VAL_EXPR PLUSEQ ASSIGN_EXPR
   53            | LEFT_VAL_EXPR MINUSEQ ASSIGN_EXPR
   54            | LEFT_VAL_EXPR MULEQ ASSIGN_EXPR
   55            | LEFT_VAL_EXPR DIVEQ ASSIGN_EXPR
   56            | LEFT_VAL_EXPR MODEQ ASSIGN_EXPR
   57            | LEFT_VAL_EXPR BITOREQ ASSIGN_EXPR
   58            | LEFT_VAL_EXPR BITANDEQ ASSIGN_EXPR
   59            | LEFT_VAL_EXPR BITXOREQ ASSIGN_EXPR
   60            | LEFT_VAL_EXPR LSHIFTEQ ASSIGN_EXPR
   61            | LEFT_VAL_EXPR RSHIFTEQ ASSIGN_EXPR

   62 EXPR_LIST: NOCOMMA_EXPR
   63          | EXPR_LIST COMMA NOCOMMA_EXPR

   64 EXPR: NOCOMMA_EXPR
   65     | EXPR COMMA NOCOMMA_EXPR

   66 NOCOMMA_EXPR: ASSIGN_EXPR

   67 LOGICAL_OR_EXPR: LOGICAL_OR_EXPR OR LOGICAL_AND_EXPR
   68                | LOGICAL_AND_EXPR

   69 CONDITIONAL_EXPR: LOGICAL_OR_EXPR
   70                 | LOGICAL_OR_EXPR QUESTION EXPR COLON CONDITIONAL_EXPR

   71 LOGICAL_AND_EXPR: LOGICAL_AND_EXPR AND BIT_OR_EXPR
   72                 | BIT_OR_EXPR

   73 EQUALITY_EXPR: EQUALITY_EXPR EQ RELATIONAL_EXPR
   74              | EQUALITY_EXPR NE RELATIONAL_EXPR
   75              | RELATIONAL_EXPR

   76 RELATIONAL_EXPR: RELATIONAL_EXPR LT SHIFT_EXPR
   77                | RELATIONAL_EXPR LE SHIFT_EXPR
   78                | RELATIONAL_EXPR GT SHIFT_EXPR
   79                | RELATIONAL_EXPR GE SHIFT_EXPR
   80                | SHIFT_EXPR

   81 SHIFT_EXPR: SHIFT_EXPR LSHIFT ADDSUB_EXPR
   82           | SHIFT_EXPR RSHIFT ADDSUB_EXPR
   83           | ADDSUB_EXPR

   84 BIT_OR_EXPR: BIT_OR_EXPR BITOR BIT_XOR_EXPR
   85            | BIT_XOR_EXPR

   86 BIT_XOR_EXPR: BIT_XOR_EXPR BITXOR BIT_AND_EXPR
   87             | BIT_AND_EXPR

   88 BIT_AND_EXPR: BIT_AND_EXPR BITAND EQUALITY_EXPR
   89             | EQUALITY_EXPR

   90 ADDSUB_EXPR: ADDSUB_EXPR PLUS MULDIV_EXPR
   91            | ADDSUB_EXPR MINUS MULDIV_EXPR
   92            | MULDIV_EXPR

   93 MULDIV_EXPR: MULDIV_EXPR STAR UNARY_EXPR
   94            | MULDIV_EXPR SLASH UNARY_EXPR
   95            | MULDIV_EXPR MOD UNARY_EXPR
   96            | UNARY_EXPR

   97 UNARY_EXPR: POSTFIX_EXPR
   98           | UNARY_OP UNARY_EXPR
   99           | PLUSPLUS LEFT_VAL_EXPR
  100           | MINUSMINUS LEFT_VAL_EXPR

  101 POSTFIX_EXPR: BASIC_EXPR
  102             | POSTFIX_EXPR PLUSPLUS
  103             | POSTFIX_EXPR MINUSMINUS

  104 BASIC_EXPR: LITERAL_EXPR
  105           | LEFT_VAL_EXPR
  106           | LPAREN EXPR RPAREN
  107           | FUNC_CALL_EXPR

  108 FUNC_CALL_EXPR: IDENT LPAREN RPAREN
  109               | IDENT LPAREN EXPR_LIST RPAREN

  110 ARRAY_DIMENSION_EXPR: LBRACKET NOCOMMA_EXPR RBRACKET

  111 ARRAY_DIMENSION_EXPR_LIST: ARRAY_DIMENSION_EXPR
  112                          | ARRAY_DIMENSION_EXPR_LIST ARRAY_DIMENSION_EXPR

  113 LEFT_VAL_EXPR: IDENT
  114              | IDENT ARRAY_DIMENSION_EXPR_LIST

  115 LITERAL_EXPR: INT_CONST
  116             | LL_CONST
  117             | FLOAT_CONST
  118             | DOUBLE_CONST

  119 TYPE: INT
  120     | FLOAT
  121     | VOID
  122     | DOUBLE

  123 UNARY_OP: PLUS
  124         | MINUS
  125         | NOT
  126         | BITNOT


